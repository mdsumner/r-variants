+static SEXP wrapper_Extract_array_subset(SEXP x, SEXP subs, SEXP dim,
+					 SEXP call)
+{
+    /* the wrapper holds the attributes, so 'dim' is passed along */
+    SEXP w = WRAPPER_WRAPPED(x);
+    return ALTREP(w) ? ALTVEC_EXTRACT_ARRAY_SUBSET(w, subs, dim, call) : NULL;
+}
+
 
