From aa7753855e781b6a6d0433f9dd44e657ac6469e8 Mon Sep 17 00:00:00 2001
From: Michael Sumner <mdsumner@gmail.com>
Date: Mon, 26 Oct 2026 23:51:13 +0000
Subject: [PATCH] ALTREP: Extract_array_subset method for x[i, j, ...]

Offer the normalized subscripts of MatrixSubset/ArraySubset to an ALTREP
class before extracting element by element. R checks bounds (in
int_arraySubscript) and keeps setting dim, dimnames and drop; a NULL
return falls back to the existing loop. The method table is allocated by
R, so adding a method does not change the ABI for packages. Wrapper
classes forward the method.
---
 doc/NEWS.Rd                | 13 +++++++++++-
 src/include/Defn.h         |  1 +
 src/include/R_ext/Altrep.h | 11 ++++++++++
 src/main/altclasses.c      | 15 ++++++++++++++
 src/main/altrep.c          | 23 ++++++++++++++++++++-
 src/main/subset.c          | 41 +++++++++++++++++++++++++++++++++++++-
 6 files changed, 101 insertions(+), 3 deletions(-)

diff --git a/doc/NEWS.Rd b/doc/NEWS.Rd
index e2da3f7..5c4b5b7 100644
--- a/doc/NEWS.Rd
+++ b/doc/NEWS.Rd
@@ -139,7 +139,18 @@
 
   \subsection{C-Level Facilities}{
     \itemize{
-      \item .
+      \item \abbr{ALTREP} vector classes can now supply an
+      \code{Extract_array_subset} method, set with
+      \code{R_set_altvec_Extract_array_subset_method()}.  For
+      \code{x[i, j, ...]} on an \abbr{ALTREP} array, R offers the
+      method the normalized subscripts (one 1-based integer vector per
+      dimension, \code{NA} allowed) before reading element by element, so
+      a class backed by chunked or remote storage can plan a single read.
+      R still checks bounds and sets \code{dim}, \code{dimnames} and
+      \code{drop}.  A class without the method, or one that returns
+      \code{NULL}, is extracted as before.  Wrapper objects forward the
+      method.  \file{R_ext/Altrep.h} defines
+      \code{R_ALTREP_HAS_EXTRACT_ARRAY_SUBSET} for conditional compilation.
     }
   }
 
