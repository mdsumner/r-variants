 typedef void *(*R_altvec_Dataptr_method_t)(SEXP, Rboolean);
 typedef const void *(*R_altvec_Dataptr_or_null_method_t)(SEXP);
 typedef SEXP (*R_altvec_Extract_subset_method_t)(SEXP, SEXP, SEXP);
+/* Extract_array_subset(x, subs, dim, call): x[i, j, ...] for an array x
+   with dimensions 'dim'. 'subs' is a list with one integer vector per
+   dimension holding 1-based, in-range indices or NA_INTEGER, as
+   normalized by R. Return a vector of TYPEOF(x) and length
+   prod(lengths(subs)), in column-major order and without attributes, or
+   C NULL (not R_NilValue) to let R extract element by element. R sets
+   dim, dimnames and drop as usual. 'subs' and its elements may be the
+   caller's own objects and must not be modified. */
+typedef SEXP (*R_altvec_Extract_array_subset_method_t)(SEXP, SEXP, SEXP, SEXP);
+#define R_ALTREP_HAS_EXTRACT_ARRAY_SUBSET 1
 
 typedef int (*R_altinteger_Elt_method_t)(SEXP, R_xlen_t);
 typedef R_xlen_t
@@ -135,6 +145,7 @@ DECLARE_METHOD_SETTER(altrep, Length)
 DECLARE_METHOD_SETTER(altvec, Dataptr)
 DECLARE_METHOD_SETTER(altvec, Dataptr_or_null)
 DECLARE_METHOD_SETTER(altvec, Extract_subset)
+DECLARE_METHOD_SETTER(altvec, Extract_array_subset)
 
 DECLARE_METHOD_SETTER(altinteger, Elt)
 DECLARE_METHOD_SETTER(altinteger, Get_region)
