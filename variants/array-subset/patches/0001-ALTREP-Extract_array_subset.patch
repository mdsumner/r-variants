diff --git a/src/main/subset.c b/src/main/subset.c
index 1147c72..31c5f3b 100644
--- a/src/main/subset.c
+++ b/src/main/subset.c
@@ -305,6 +305,36 @@ SEXP int_arraySubscript(int dim, SEXP s, SEXP dims, SEXP x, SEXP call);
 	}							\
     } while (0)
 
+/* Offer the normalized subscripts of x[i, j, ...] to an ALTREP object.
+   's' is the pairlist of k subscripts after int_arraySubscript(), which
+   has already checked that they are in range or NA; 'n' the number of
+   values. Returns the values (a vector of TYPEOF(x) and length n,
+   column-major) or R_NilValue if x is not ALTREP or its class declines,
+   in which case the caller extracts element by element as before. */
+static SEXP ALTREP_ArraySubset(SEXP x, SEXP s, int k, R_xlen_t n, SEXP call)
+{
+    if (! ALTREP(x))
+	return R_NilValue;
+    SEXP dim = getAttrib(x, R_DimSymbol);
+    SEXP subs = PROTECT(allocVector(VECSXP, k));
+    SEXP r = s;
+    for (int i = 0; i < k; i++, r = CDR(r))
+	SET_VECTOR_ELT(subs, i, CAR(r));
+    SEXP ans = ALTVEC_EXTRACT_ARRAY_SUBSET(x, subs, dim, call);
+    if (ans == NULL) {
+	UNPROTECT(1); /* subs */
+	return R_NilValue;
+    }
+    PROTECT(ans);
+    if (TYPEOF(ans) != TYPEOF(x) || XLENGTH(ans) != n ||
+	ATTRIB(ans) != R_NilValue)
+	errorcall(call, _("invalid result from ALTREP array subset method"));
+    if (MAYBE_REFERENCED(ans))
+	ans = duplicate(ans); /* R sets attributes on the result */
+    UNPROTECT(2); /* ans, subs */
+    return ans;
+}
+
 static SEXP MatrixSubset(SEXP x, SEXP s, SEXP call, int drop)
 {
     SEXP attr, result, sr, sc, dim;
@@ -327,9 +357,13 @@ static SEXP MatrixSubset(SEXP x, SEXP s, SEXP call, int drop)
 	error(_("dimensions would exceed maximum size of array"));
     PROTECT(sr);
     PROTECT(sc);
-    result = allocVector(TYPEOF(x), (R_xlen_t) nrs * (R_xlen_t) ncs);
     const int *psr = INTEGER_RO(sr);
     const int *psc = INTEGER_RO(sc);
+    PROTECT(result = ALTREP_ArraySubset(x, s, 2,
+					(R_xlen_t) nrs * (R_xlen_t) ncs, call));
+    if (result == R_NilValue) {
+    UNPROTECT(1);
+    result = allocVector(TYPEOF(x), (R_xlen_t) nrs * (R_xlen_t) ncs);
     PROTECT(result);
     switch(TYPEOF(x)) {
     case LGLSXP:
@@ -369,6 +403,7 @@ static SEXP MatrixSubset(SEXP x, SEXP s, SEXP call, int drop)
 	errorcall(call, _("matrix subscripting not handled for this type"));
 	break;
     }
+    } /* not offered to, or declined by, ALTREP */
 
     if(nrs >= 0 && ncs >= 0) {
 	PROTECT(attr = allocVector(INTSXP, 2));
@@ -501,6 +536,9 @@ static SEXP ArraySubset(SEXP x, SEXP s, SEXP call, int drop)
 	}
 
     /* Transfer the subset elements from "x" to "a". */
+    PROTECT(result = ALTREP_ArraySubset(x, s, k, n, call));
+    if (result == R_NilValue) {
+    UNPROTECT(1);
     PROTECT(result = allocVector(mode, n));
     switch (mode) {
     case LGLSXP:
@@ -540,6 +578,7 @@ static SEXP ArraySubset(SEXP x, SEXP s, SEXP call, int drop)
 	errorcall(call, _("array subscripting not handled for this type"));
 	break;
     }
+    } /* not offered to, or declined by, ALTREP */
 
     SEXP new_dim = PROTECT(allocVector(INTSXP, k));
     for(int i = 0 ; i < k ; i++)
